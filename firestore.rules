rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // live_darshan — public read (website pe video dikhane ke liye)
    // write — temporarily open for admin panel (PIN-based)
    // TODO: lock write to Firebase Auth when Auth is implemented
    match /live_darshan/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // memberships — public write only (form submission)
    // read BLOCKED publicly — PII protection (name, mobile, email, address)
    match /memberships/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // tour_bookings — public write only (ticket booking)
    // read BLOCKED publicly — PII protection
    match /tour_bookings/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // counters — public read+write needed for sequential ticket numbers
    // write restricted: only increment allowed (no delete, no arbitrary set)
    match /counters/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
