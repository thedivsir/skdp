rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // live_darshan — public read + write (admin panel PIN se)
    match /live_darshan/{docId} {
      allow read, write: if true;
    }

    // donations — public write (donation form), read allowed (admin panel)
    match /donations/{docId} {
      allow read, write: if true;
    }

    // memberships — public write (form submission) + read (admin panel)
    match /memberships/{docId} {
      allow read, write: if true;
    }

    // tour_bookings — public write (ticket booking) + read (admin panel)
    match /tour_bookings/{docId} {
      allow read, write: if true;
    }

    // counters — sequential ticket number generation
    match /counters/{docId} {
      allow read, write: if true;
    }
  }
}
